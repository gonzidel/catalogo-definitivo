    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const inputItems = $input.all();\nconst base = inputItems[0]?.json || {};\nconst ids = inputItems.map((item) => item.json.id).filter(Boolean);\nconst attachedMedia = ids.map((id) => ({ media_fbid: String(id) }));\nreturn [{ json: { ...base, photoIds: ids, attachedMedia: JSON.stringify(attachedMedia) } }];"
