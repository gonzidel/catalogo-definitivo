# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
firebase-debug.log*
firebase-debug.*.log*

# Firebase cache
.firebase/

# Firebase config

# Uncomment this if you'd like others to create their own Firebase project.
# For a team working on the same Firebase project(s), it is recommended to leave
# it commented so all members can deploy to the same project(s) in .firebaserc.
# .firebaserc

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# nyc test coverage
.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env
.env.local
.env.local.example
backend/.env
backend/node_modules/
backend/dist/

# dataconnect generated files
.dataconnect
 
# Credenciales privadas
clave/
 
# Ignorar configuración local con secretos
scripts/config.local.js
# Configuración de producción (se genera durante el deploy)
config.prod.js

# Certificados y llaves privadas de QZ Tray
qz-private-key.pem
qz-private.pk8.der
qz-private.pk8.der.b64
qz-certificate.crt
qz-certificate.p12
qz-cert.conf

# Configuración local (contiene secretos)
config.local.js

# Llaves privadas exportadas (no commitear nunca)
*.pem

# Artefactos locales
diff-dashboard-instant.txt

# Supabase CLI cache (no versionar)
supabase/.temp/

# Config local de herramientas (no versionar)
.claude/
.obsidian/

# Salidas locales de auditorías / probes (pueden incluir metadatos sensibles)
audit-output/

# Artefactos locales de scripts (evidencia MCP, payloads, smokes)
scripts/outputs/*
!scripts/outputs/.gitkeep

# Cachés rotos de Next.js (copias de .next, no versionar)
**/.next-broken*/

# Config local de Vercel
.vercel/

# Temporales y basura local de Windows
tmp/
*.lnk
nul
backend/nul
.vercel
