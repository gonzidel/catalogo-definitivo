    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Columnas esperadas en Google Sheets:\n// A=Facebook, B=Instagram, C=Oferta, D=Producto, E=Color\n// F=Talles Disponibles, G=Precio, H=Descripci?n\n// I-T = URLs 1 a URLs 12\n\nconst row = $input.item.json;\n\nconst clean = (value) => String(value ?? '').trim();\nconst isYes = (value) => clean(value).toLowerCase() === 'si';\n\nconst urlKeys = Array.from({ length: 12 }, (_, i) => `URLs ${i + 1}`);\nconst photoUrls = urlKeys\n  .map((key) => clean(row[key]))\n  .filter(Boolean);\n\nconst product = clean(row.Producto);\nconst description = clean(row['Descripci?n']);\nconst sizes = clean(row['Talles Disponibles']);\nconst price = clean(row.Precio);\nconst color = clean(row.Color);\nconst isOferta = isYes(row.Oferta);\n\nconst igCaption = [\n  `Art. ${product}?`,\n  description,\n  `Numeracion: ~${sizes}~`,\n  `${price} Precio por Mayor`,\n  '',\n  '?? M?s modelos disponibles en el cat?logo',\n  '?? https://fylmoda.com.ar/',\n].filter((line) => line !== undefined && line !== null).join('\\n');\n\nconst fbCaptionNormal = [\n  `Art. ${product}?`,\n  description,\n  `Numeracion: ~${sizes}~`,\n  `${price} Precio por Mayor`,\n  '',\n  '?? Modelo ya disponible en nuestro cat?logo',\n  '?? https://fylmoda.com.ar/',\n].filter((line) => line !== undefined && line !== null).join('\\n');\n\nconst fbCaptionOferta = [\n  'OFERTA????',\n  `Art. ${product}?`,\n  `Colores: ${color}`,\n  description,\n  `Numeracion: ~${sizes}~`,\n  `${price} Precio por Mayor`,\n  '',\n  '?? Modelo ya disponible en nuestro cat?logo',\n  '?? https://fylmoda.com.ar/',\n].filter((line) => line !== undefined && line !== null).join('\\n');\n\nconst photoCount = photoUrls.length;\nconst postToInstagram = isYes(row.Instagram) && photoCount > 0;\nconst postToFacebook = isYes(row.Facebook) && photoCount > 0;\n\nreturn {\n  json: {\n    ...row,\n    Facebook: row.Facebook,\n    Instagram: row.Instagram,\n    Oferta: row.Oferta,\n    Producto: product,\n    Color: color,\n    Talles: sizes,\n    Precio: price,\n    Descripcion: description,\n    photoUrls,\n    photoCount,\n    igCaption,\n    fbCaption: isOferta ? fbCaptionOferta : fbCaptionNormal,\n    igUserId: '17841405282710550',\n    fbPageId: '1064608640244020',\n    postToInstagram,\n    postToFacebook,\n    skipReason: photoCount === 0 ? 'sin_fotos' : null,\n  },\n};"
      },
