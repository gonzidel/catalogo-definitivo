        "jsCode": "const inputItems = $input.all();\nconst creationIds = inputItems\n  .map((item) => item.json.id)\n  .filter(Boolean);\n\nconst base = $('IG - Dividir URLs Carousel').first().json;\n\nreturn [{\n  json: {\n    ...base,\n    creationIds,\n    children: creationIds.join(','),\n  },\n}];"
