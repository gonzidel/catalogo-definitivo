    {
      "id": "pub_restore_for_facebook",
      "name": "Preparar Datos para Facebook",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        520
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "let data = $input.item.json;\n\nif (!data.postToFacebook) {\n  try {\n    const prepared = $('Preparar Datos').item.json;\n    if (prepared && prepared.Producto) data = prepared;\n  } catch (error) {}\n}\n\nif (!data.postToFacebook) {\n  try {\n    const carousel = $('IG - Armar Carousel').item.json;\n    if (carousel && carousel.Producto) data = carousel;\n  } catch (error) {}\n}\n\nreturn { json: data };"
      }
