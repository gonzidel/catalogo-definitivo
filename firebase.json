{
  "hosting": {
    "predeploy": [
      "npm run build",
      "npm run bundle:supabase"
    ],
    "public": ".",
    "ignore": [
      "firebase.json",
      ".git/**",
      "**/.git/**",
      ".obsidian/**",
      "audit-output/**",
      "scripts/smoke-*.mjs",
      "scripts/main-simple.js",
      "scripts/main-optimized.js",
      "scripts/main.js",
      "scripts/vendor/supabase-js.bundle.js",
      "qz-private*",
      "*.pk8*",
      "package*.json",
      "**/.*",
      "**/.claude/**",
      "**/.cursor/**",
      "**/.husky/**",
      "**/node_modules/**",
      "**/*.ps1",
      "**/*.bat",
      "**/*.cmd",
      "**/*.sh",
      "**/*.exe",
      "**/*.pem",
      "**/*.key",
      "**/*.p12",
      "**/*.sql",
      "**/*.kt",
      "clave/**",
      "*.md",
      "test/**",
      "scripts/generate-config.mjs",
      "deploy.js",
      "supabase/**",
      "cloudinary-optimize/**",
      "history/**",
      "certs/**",
      "!certs/qz-site.crt",
      "config.local.js",
      "generate_*.js",
      "scripts/generate-*.js",
      "scripts/extract-*.js",
      "scripts/verify-*.js",
      "scripts/fetch-*.js",
      "qz-private-*.pem",
      "debug-*.html",
      "diagnostico-*.html",
      "test-*.html",
      "verificar-*.html"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "/catalogo",
        "type": 301
      },
      {
        "source": "/index.html",
        "destination": "/catalogo",
        "type": 301
      },
      {
        "source": "/client/dashboard.html",
        "destination": "/catalogo",
        "type": 302
      },
      {
        "source": "/client/dashboard",
        "destination": "/catalogo",
        "type": 302
      },
      {
        "source": "/client/dashboard-debug.html",
        "destination": "/catalogo",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "/privacy-policy",
        "destination": "/privacy-policy.html"
      },
      {
        "source": "/privacy-policy/**",
        "destination": "/privacy-policy.html"
      },
      {
        "source": "/terms",
        "destination": "/terms.html"
      },
      {
        "source": "/terms/**",
        "destination": "/terms.html"
      },
      {
        "source": "/catalogo",
        "destination": "/catalogo.html"
      },
      {
        "source": "/catalogo/**",
        "destination": "/catalogo.html"
      },
      {
        "source": "/revendedoras",
        "destination": "/revendedoras.html"
      },
      {
        "source": "/revendedoras/**",
        "destination": "/revendedoras.html"
      },
      {
        "source": "/calzado-femenino-por-mayor",
        "destination": "/calzado-femenino-por-mayor.html"
      },
      {
        "source": "/calzado-femenino-por-mayor/**",
        "destination": "/calzado-femenino-por-mayor.html"
      },
      {
        "source": "/ropa-femenina-por-mayor",
        "destination": "/ropa-femenina-por-mayor.html"
      },
      {
        "source": "/ropa-femenina-por-mayor/**",
        "destination": "/ropa-femenina-por-mayor.html"
      },
      {
        "source": "/quienes-somos",
        "destination": "/quienes-somos.html"
      },
      {
        "source": "/quienes-somos/**",
        "destination": "/quienes-somos.html"
      },
      {
        "source": "/lenceria-por-mayor",
        "destination": "/lenceria-por-mayor.html"
      },
      {
        "source": "/lenceria-por-mayor/**",
        "destination": "/lenceria-por-mayor.html"
      },
      {
        "source": "/accesorios-por-mayor",
        "destination": "/accesorios-por-mayor.html"
      },
      {
        "source": "/accesorios-por-mayor/**",
        "destination": "/accesorios-por-mayor.html"
      },
      {
        "source": "**",
        "destination": "/catalogo.html"
      }
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Pragma",
            "value": "no-cache"
          },
          {
            "key": "Service-Worker-Allowed",
            "value": "/"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Pragma",
            "value": "no-cache"
          },
          {
            "key": "Expires",
            "value": "0"
          }
        ]
      },
      {
        "source": "/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Pragma",
            "value": "no-cache"
          },
          {
            "key": "Expires",
            "value": "0"
          }
        ]
      },
      {
        "source": "/client/**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Pragma",
            "value": "no-cache"
          },
          {
            "key": "Expires",
            "value": "0"
          }
        ]
      },
      {
        "source": "/manifest.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/manifest+json"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Pragma",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "admin/**/*.@(js|css|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Pragma",
            "value": "no-cache"
          },
          {
            "key": "Expires",
            "value": "0"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "scripts/vendor/supabase-js.bundle.min.js",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/javascript; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400, must-revalidate"
          }
        ]
      },
      {
        "source": "/config.prod.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Content-Type",
            "value": "application/javascript; charset=utf-8"
          }
        ]
      },
      {
        "source": "/fyl-flags.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "scripts/config.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "scripts/boot-telemetry.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "scripts/fyl-version.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "scripts/fyl-runtime-resilience.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "scripts/config.local.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/qz-site.crt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/x-x509-ca-cert"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/certs/qz-site.crt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/x-x509-ca-cert"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "**/*.crt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/x-x509-ca-cert"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ]
  }
}
