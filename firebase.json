{
  "hosting": {
    "predeploy": [
      "npm run build",
      "npm run bundle:supabase"
    ],
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "clave/**",
      "*.md",
      "test/**",
      "scripts/generate-config.mjs",
      "deploy.js",
      "deploy.ps1",
      "*.bat",
      "*.ps1",
      "*.pem",
      "*.sql",
      "*.kt",
      "*.p12",
      "supabase/**",
      "cloudinary-optimize/**",
      "certs/**",
      "!certs/qz-site.crt",
      "config.local.js",
      "generate_*.js",
      "scripts/generate-*.js",
      "scripts/extract-*.js",
      "scripts/verify-*.js",
      "scripts/verify-*.ps1",
      "scripts/fetch-*.js",
      "verify-*.ps1",
      "qz-private-*.pem",
      "debug-*.html",
      "diagnostico-*.html",
      "test-*.html",
      "verificar-*.html"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "/catalogo",
        "type": 301
      },
      {
        "source": "/index.html",
        "destination": "/catalogo",
        "type": 301
      },
      {
        "source": "/client/dashboard.html",
        "destination": "/catalogo",
        "type": 302
      },
      {
        "source": "/client/dashboard",
        "destination": "/catalogo",
        "type": 302
      },
      {
        "source": "/client/dashboard-debug.html",
        "destination": "/catalogo",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "/privacy-policy",
        "destination": "/privacy-policy.html"
      },
      {
        "source": "/privacy-policy/**",
        "destination": "/privacy-policy.html"
      },
      {
        "source": "/terms",
        "destination": "/terms.html"
      },
      {
        "source": "/terms/**",
        "destination": "/terms.html"
      },
      {
        "source": "/catalogo",
        "destination": "/catalogo.html"
      },
      {
        "source": "/catalogo/**",
        "destination": "/catalogo.html"
      },
      {
        "source": "**",
        "destination": "/catalogo.html"
      }
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Pragma",
            "value": "no-cache"
          },
          {
            "key": "Service-Worker-Allowed",
            "value": "/"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Pragma",
            "value": "no-cache"
          },
          {
            "key": "Expires",
            "value": "0"
          }
        ]
      },
      {
        "source": "/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Pragma",
            "value": "no-cache"
          },
          {
            "key": "Expires",
            "value": "0"
          }
        ]
      },
      {
        "source": "/client/**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Pragma",
            "value": "no-cache"
          },
          {
            "key": "Expires",
            "value": "0"
          }
        ]
      },
      {
        "source": "/manifest.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/manifest+json"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Pragma",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "admin/**/*.@(js|css|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Pragma",
            "value": "no-cache"
          },
          {
            "key": "Expires",
            "value": "0"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "scripts/vendor/supabase-js.bundle.min.js",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/javascript; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400, must-revalidate"
          }
        ]
      },
      {
        "source": "/config.prod.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Content-Type",
            "value": "application/javascript; charset=utf-8"
          }
        ]
      },
      {
        "source": "/fyl-flags.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "scripts/config.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "scripts/boot-telemetry.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      
      {
        "source": "scripts/config.local.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/qz-site.crt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/x-x509-ca-cert"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/certs/qz-site.crt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/x-x509-ca-cert"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "**/*.crt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/x-x509-ca-cert"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ]
  }
}
