    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const row = $input.item.json;\n\nconst clean = (value) => String(value ?? '').trim();\nconst isYes = (value) => clean(value).toLowerCase() === 'si';\nconst urlKeys = Array.from({ length: 12 }, (_, i) => 'URLs ' + (i + 1));\nconst photoUrls = urlKeys.map((key) => clean(row[key])).filter(Boolean);\n\nconst product = clean(row.Producto);\nconst description = clean(row['Descripci?n'] ?? row['Descripcion']);\nconst sizes = clean(row['Talles Disponibles']);\nconst price = clean(row.Precio);\nconst color = clean(row.Color);\nconst isOferta = isYes(row.Oferta);\n\nconst igCaption = [\n  'Art. ' + product,\n  description,\n  'Numeracion: ~' + sizes + '~',\n  price + ' Precio por Mayor',\n  '',\n  'Mas modelos disponibles en el catalogo',\n  'https://fylmoda.com.ar/'\n].join('\\n');\n\nconst fbCaptionNormal = [\n  'Art. ' + product,\n  description,\n  'Numeracion: ~' + sizes + '~',\n  price + ' Precio por Mayor',\n  '',\n  'Modelo ya disponible en nuestro catalogo',\n  'https://fylmoda.com.ar/'\n].join('\\n');\n\nconst fbCaptionOferta = [\n  'OFERTA',\n  'Art. ' + product,\n  'Colores: ' + color,\n  description,\n  'Numeracion: ~' + sizes + '~',\n  price + ' Precio por Mayor',\n  '',\n  'Modelo ya disponible en nuestro catalogo',\n  'https://fylmoda.com.ar/'\n].join('\\n');\n\nreturn {\n  json: {\n    ...row,\n    Producto: product,\n    Color: color,\n    Talles: sizes,\n    Precio: price,\n    Descripcion: description,\n    photoUrls,\n    photoCount: photoUrls.length,\n    igCaption,\n    fbCaption: isOferta ? fbCaptionOferta : fbCaptionNormal,\n    igUserId: '17841405282710550',\n    fbPageId: '1064608640244020',\n    postToInstagram: isYes(row.Instagram) && photoUrls.length > 0,\n    postToFacebook: isYes(row.Facebook) && photoUrls.length > 0\n  }\n};"
      },
      "id": "e1e6eef0-25d0-4ab7-8299-ed5471b1fa27",
